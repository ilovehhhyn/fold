{
	"name": "paper-fortune-teller",
	"version": "1.0.0",
	"description": "An interactive 3D paper fortune teller for the web.",
	"private": true,
	"homepage": "https://ilovehhhyn.github.io/fold/",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"encrypt-letter": "node scripts/encrypt-letter.ts",
