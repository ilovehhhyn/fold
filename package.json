		"test:browser": "playwright test"
	},
	"dependencies": {
		"three": "0.187.0"
	},
	"devDependencies": {
		"@playwright/test": "1.65.1",
		"@types/node": "26.6.6",
		"@types/three": "0.187.0",
		"typescript": "7.0.2",
		"vite": "8.3.8",
		"vitest": "5.1.0"
	}
}
